package templates

templ StatusCards(services []ServiceStatus) {
	<div class="status-grid">
		for _, s := range services {
			@statusCard(s)
		}
	</div>
}

templ statusCard(s ServiceStatus) {
	<div class="status-card">
		<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
			<div style="display: flex; align-items: center; gap: 10px;">
				if s.Connected {
					<span class="status-dot ok"></span>
				} else {
					<span class="status-dot err"></span>
				}
				<span class="service-name">{ s.Name }</span>
			</div>
			if s.Connected {
				<span class="status-badge ok">Connected</span>
			} else {
				<span class="status-badge err">Disconnected</span>
			}
		</div>
		<p class="checked-at">{ s.CheckedAt }</p>
	</div>
}
