package templates

templ Dashboard() {
	@Layout("Dashboard") {
		<div class="mb-6">
			<h1 class="text-2xl font-semibold text-slate-100">System Status</h1>
			<p class="text-slate-400 text-sm mt-1">Live connection health — refreshes every 10 seconds</p>
		</div>
		<div
			id="status-cards"
			hx-get="/admin/api/status"
			hx-trigger="load, every 10s"
			hx-swap="innerHTML"
		></div>
	}
}
