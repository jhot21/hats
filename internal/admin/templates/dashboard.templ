package templates

templ Dashboard() {
	@Layout("Dashboard", "Observability") {
		<div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28px;">
			<div>
				<h1 class="page-title">System <strong>Overview</strong></h1>
				<div class="page-meta">
					<span class="pulse">Live Connection Health</span>
					<span>·</span>
					<span>REFRESHES EVERY 10 SECONDS</span>
				</div>
			</div>
		</div>
		<div
			id="status-cards"
			hx-get="/admin/api/status"
			hx-trigger="load, every 10s"
			hx-swap="innerHTML"
		></div>
		<div
			id="cache-stats"
			hx-get="/admin/api/cache/stats"
			hx-trigger="load, every 30s"
			hx-swap="innerHTML"
		></div>
	}
}
