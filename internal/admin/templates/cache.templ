package templates

// Cache renders the full cache browser admin page shell.
templ Cache() {
	@Layout("Cache", "Administration") {
		<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:32px;">
			<div>
				<h1 class="page-title">Cache <strong>Browser</strong></h1>
				<div class="page-meta">173 entities cached · 2hr ttl · hats kv bucket</div>
			</div>
			<div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;margin-top:6px;">
				<button
					class="btn btn-danger"
					hx-post="/admin/api/cache/stats/reset"
					hx-target="#cache-stats"
					hx-swap="innerHTML"
					hx-confirm="Reset all cache hit/miss statistics?">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 .49-3.5"></path></svg>
					Reset Stats
				</button>
				<span style="font-family:var(--font-mono);font-size:10px;color:var(--text-mute);">Clears accumulated hit/miss counts</span>
			</div>
		</div>
		<!-- Stats panel (auto-refreshes every 30s) -->
		<div
			id="cache-stats"
			hx-get="/admin/api/cache/stats"
			hx-trigger="load, every 30s"
			hx-swap="innerHTML"
			style="margin-bottom:24px;">
		</div>
		<!-- Toolbar: search + domain filter -->
		<div class="cache-toolbar">
			<div class="search-box">
				<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#5f7787" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
				<input
					id="entity-search"
					name="q"
					placeholder="Search entity ID…"
					hx-get="/admin/api/cache/entities"
					hx-trigger="keyup changed delay:300ms"
					hx-target="#entity-table-container"
					hx-swap="innerHTML"
					hx-include="#domain-filter"/>
			</div>
			<div class="filter-tabs">
				<input type="hidden" id="domain-filter" name="domain" value=""/>
				<button class="filter-tab active" onclick="setDomain(event, '')">All</button>
				<button class="filter-tab" onclick="setDomain(event, 'sensor')">sensor</button>
				<button class="filter-tab" onclick="setDomain(event, 'binary_sensor')">binary_sensor</button>
				<button class="filter-tab" onclick="setDomain(event, 'timer')">timer</button>
				<button class="filter-tab" onclick="setDomain(event, 'input_boolean')">input_boolean</button>
				<button class="filter-tab" onclick="setDomain(event, 'switch')">switch</button>
			</div>
		</div>
		<!-- Entity table (auto-refreshes every 15s, respects current filter) -->
		<div class="panel" style="overflow:hidden;">
			<div
				id="entity-table-container"
				hx-get="/admin/api/cache/entities"
				hx-trigger="load, every 15s"
				hx-swap="innerHTML"
				hx-include="#domain-filter, #entity-search">
			</div>
		</div>
		<script>
			function setDomain(event, domain) {
				document.getElementById('domain-filter').value = domain;
				document.querySelectorAll('.filter-tab').forEach(function(t) { t.classList.remove('active'); });
				event.currentTarget.classList.add('active');
				htmx.trigger(document.getElementById('entity-table-container'), 'load');
			}
		</script>
	}
}
