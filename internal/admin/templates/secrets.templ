package templates

templ Secrets(ss []SecretData) {
	@Layout("Secrets", "Administration") {
		<div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28px;">
			<div>
				<h1 class="page-title">Access <strong>Secrets</strong></h1>
				<div class="page-meta">
					<span>MANAGE ENCRYPTED AND PLAINTEXT SECRETS</span>
				</div>
			</div>
			<button
				hx-get="/admin/secrets/new"
				hx-target="#modal-content"
				hx-swap="innerHTML"
				hx-on::after-request="document.getElementById('secret-modal').showModal()"
				class="btn btn-primary"
			>
				+ Create Secret
			</button>
		</div>
		<div id="secret-list">
			@SecretList(ss)
		</div>
		<dialog id="secret-modal" class="modal-backdrop modal-backdrop--wide">
			<div id="modal-content"></div>
		</dialog>
	}
}

templ SecretList(ss []SecretData) {
	if len(ss) == 0 {
		<div class="panel" style="padding: 40px; text-align: center;">
			<p style="font-family: var(--font-mono); font-size: 13px; color: var(--text-mute); letter-spacing: 0.05em;">
				No secrets yet. Create one to get started.
			</p>
		</div>
	} else {
		<div class="secret-list">
			for _, s := range ss {
				@secretCard(s)
			}
		</div>
	}
}

templ secretCard(s SecretData) {
	<div class="secret-card">
		<div class="secret-card-name">{ s.Name }</div>
		<span class={ SecretTypeBadgeClass(s.Type) }>{ SecretTypeLabel(s.Type) }</span>
		<div class="secret-card-meta">
			Updated { s.UpdatedAt }
		</div>
		<div class="secret-card-actions">
			<button
				hx-get={ "/admin/secrets/" + s.Name + "/edit" }
				hx-target="#modal-content"
				hx-swap="innerHTML"
				hx-on::after-request="document.getElementById('secret-modal').showModal()"
				class="btn btn-ghost"
			>
				Edit
			</button>
			<button
				hx-delete={ "/admin/api/secrets/" + s.Name }
				hx-confirm={ "Delete secret \"" + s.Name + "\"? This cannot be undone." }
				hx-target="#secret-list"
				hx-swap="innerHTML"
				class="btn btn-danger"
			>
				Delete
			</button>
		</div>
	</div>
}
