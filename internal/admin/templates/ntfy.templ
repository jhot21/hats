package templates

templ Ntfy(data NtfyConnectionData) {
	@Layout("ntfy", "Administration") {
		<div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28px;">
			<div>
				<h1 class="page-title"><strong>ntfy</strong></h1>
				<div class="page-meta">
					<span>MANAGE NTFY CONNECTION</span>
				</div>
			</div>
		</div>
		<div class="panel" style="padding: 32px; max-width: 560px;">
			if data.Error != "" {
				<p class="login-error" style="margin: 0 0 20px 0;">{ data.Error }</p>
			}
			<form
				id="ntfy-form"
				hx-post="/admin/api/ntfy"
				hx-target="#ntfy-result"
				hx-swap="innerHTML"
			>
				<div class="form-field">
					<label class="form-label" for="ntfy-host">Host</label>
					<input
						id="ntfy-host"
						type="text"
						name="host"
						value={ data.Host }
						class="form-input"
						placeholder="https://ntfy.sh"
					/>
				</div>
				<div class="form-field">
					<label class="form-label" for="ntfy-token">Token</label>
					<div id="ntfy-token-wrapper" style="display: flex; gap: 8px; align-items: center;">
						<input
							id="ntfy-token"
							type="password"
							name="token"
							class="form-input"
							placeholder="Leave blank to keep existing token"
							style="flex: 1;"
						/>
						<button
							type="button"
							class="btn btn-ghost"
							hx-get="/admin/api/ntfy/token"
							hx-target="#ntfy-token-wrapper"
							hx-swap="outerHTML"
						>Reveal</button>
					</div>
				</div>
				<div style="display: flex; gap: 12px; margin-top: 24px;">
					<button type="submit" class="btn btn-primary">Save</button>
				</div>
			</form>
			<div id="ntfy-result" style="margin-top: 16px;"></div>
		</div>
		<div class="panel" style="padding: 32px; max-width: 560px; margin-top: 24px;">
			<h2 style="font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 12px 0; opacity: 0.7;">Test Connection</h2>
			<p style="margin: 0 0 20px 0; font-size: 14px; opacity: 0.7;">
				Enter a topic to verify write (publish) and read (poll) access using the credentials above.
			</p>
			<form
				id="ntfy-test-form"
				hx-post="/admin/api/ntfy/test"
				hx-include="#ntfy-form"
				hx-target="#ntfy-test-result"
				hx-swap="innerHTML"
			>
				<div class="form-field">
					<label class="form-label" for="ntfy-test-topic">Test Topic</label>
					<input
						id="ntfy-test-topic"
						type="text"
						name="test_topic"
						class="form-input"
						placeholder="my-topic"
					/>
				</div>
				<div style="display: flex; gap: 12px; margin-top: 24px;">
					<button type="submit" class="btn btn-ghost">Test Connection</button>
				</div>
			</form>
			<div id="ntfy-test-result" style="margin-top: 16px;"></div>
		</div>
	}
}

templ NtfyTestResult(writeOK bool, writeMsg string, readOK bool, readMsg string) {
	if writeOK {
		<p class="login-error" style="color: var(--teal);">Write: { writeMsg }</p>
	} else {
		<p class="login-error">Write: { writeMsg }</p>
	}
	if readOK {
		<p class="login-error" style="color: var(--teal);">Read: { readMsg }</p>
	} else {
		<p class="login-error">Read: { readMsg }</p>
	}
}

templ NtfySaveResult(ok bool, message string) {
	if ok {
		<p class="login-error" style="color: var(--teal);">{ message }</p>
	} else {
		<p class="login-error">{ message }</p>
	}
}

templ NtfyTokenReveal(token string) {
	<div id="ntfy-token-wrapper" style="display: flex; gap: 8px; align-items: center;">
		if token == "" {
			<input
				id="ntfy-token"
				type="text"
				name="token"
				class="form-input"
				placeholder="No token stored"
				style="flex: 1;"
			/>
		} else {
			<input
				id="ntfy-token"
				type="text"
				name="token"
				value={ token }
				class="form-input"
				style="flex: 1;"
			/>
		}
		<button type="button" class="btn btn-ghost" onclick="togglePwd(this)">Hide</button>
	</div>
}
