package templates

templ SecretCreateForm(errMsg string, selectedType string) {
	if selectedType == "" {
		selectedType = "basic_string"
	}
	<div class="modal">
		<div class="modal-header">
			<div>
				<div class="modal-eyebrow">Administration</div>
				<div class="modal-title">Create Secret</div>
			</div>
			<button
				type="button"
				onclick="document.getElementById('secret-modal').close()"
				class="modal-close"
				aria-label="Close"
			>&times;</button>
		</div>
		if errMsg != "" {
			<p class="login-error" style="margin: 0 28px;">{ errMsg }</p>
		}
		<form
			hx-post="/admin/api/secrets"
			hx-target="#modal-content"
			hx-swap="innerHTML"
			style="display: flex; flex-direction: column; flex: 1;"
		>
			<div class="modal-body">
				<div class="form-field">
					<label class="form-label" for="secret-name">Name <span class="required">*</span></label>
					<input
						id="secret-name"
						type="text"
						name="name"
						required
						autofocus
						pattern="[a-zA-Z0-9_-]+"
						placeholder="e.g. database_password"
						class="form-input"
					/>
					<p class="form-help">Letters, numbers, hyphens, and underscores only.</p>
				</div>
				<div class="form-field">
					<label class="form-label" for="secret-type">Type <span class="required">*</span></label>
					<select
						id="secret-type"
						name="type"
						class="form-input"
						onchange="switchSecretType(this.value)"
					>
						<option value="basic_string" selected?={ selectedType == "basic_string" }>Basic String</option>
						<option value="encrypted_string" selected?={ selectedType == "encrypted_string" }>Encrypted String</option>
						<option value="yaml" selected?={ selectedType == "yaml" }>YAML</option>
						<option value="json" selected?={ selectedType == "json" }>JSON</option>
					</select>
				</div>
				<div class="form-field">
					<label class="form-label">Value <span class="required">*</span></label>
					<div class="value-editor" data-type="basic_string">
						<input type="text" data-value-input name="value" class="form-input" placeholder="Enter value..." required/>
					</div>
					<div class="value-editor" data-type="encrypted_string" style="display:none">
						<div class="input-with-toggle">
							<input type="password" data-value-input class="form-input" placeholder="Enter secret value..."/>
							<button type="button" class="input-toggle-btn" onclick="togglePwd(this)">Show</button>
						</div>
					</div>
					<div class="value-editor" data-type="yaml" style="display:none">
						<div class="cm-host" data-lang="yaml"></div>
						<textarea data-value-input name="" style="display:none"></textarea>
					</div>
					<div class="value-editor" data-type="json" style="display:none">
						<div class="cm-host" data-lang="json"></div>
						<textarea data-value-input name="" style="display:none"></textarea>
					</div>
				</div>
			</div>
			<div class="modal-footer">
				<span></span>
				<div style="display: flex; gap: 10px;">
					<button type="button" onclick="document.getElementById('secret-modal').close()" class="btn btn-ghost">Cancel</button>
					<button type="submit" class="btn btn-primary">Create Secret</button>
				</div>
			</div>
		</form>
	</div>
	<script>switchSecretType("{ selectedType }");</script>
}

templ SecretEditForm(s SecretData, currentValue string, errMsg string) {
	<div class="modal">
		<div class="modal-header">
			<div>
				<div class="modal-eyebrow">Administration</div>
				<div class="modal-title">Edit Secret</div>
			</div>
			<button
				type="button"
				onclick="document.getElementById('secret-modal').close()"
				class="modal-close"
				aria-label="Close"
			>&times;</button>
		</div>
		if errMsg != "" {
			<p class="login-error" style="margin: 0 28px;">{ errMsg }</p>
		}
		<form
			hx-put={ "/admin/api/secrets/" + s.Name }
			hx-target="#modal-content"
			hx-swap="innerHTML"
			style="display: flex; flex-direction: column; flex: 1;"
		>
			<div class="modal-body">
				<div class="form-field">
					<label class="form-label">Name</label>
					<input type="text" value={ s.Name } class="form-input" readonly style="color: var(--text-mute);"/>
				</div>
				<div class="form-field">
					<label class="form-label">Type</label>
					<input type="hidden" name="type" value={ s.Type }/>
					<span class={ SecretTypeBadgeClass(s.Type) }>{ SecretTypeLabel(s.Type) }</span>
				</div>
				<div class="form-field">
					<label class="form-label">Value <span class="required">*</span></label>
					if s.Type == "basic_string" {
						<input type="text" name="value" value={ currentValue } class="form-input" required/>
					} else if s.Type == "encrypted_string" {
						<div class="input-with-toggle">
							<input type="password" name="value" value={ currentValue } class="form-input" required/>
							<button type="button" class="input-toggle-btn" onclick="togglePwd(this)">Show</button>
						</div>
					} else {
						<div class="cm-host" data-lang={ s.Type }></div>
						<textarea name="value" style="display:none">{ currentValue }</textarea>
					}
				</div>
			</div>
			<div class="modal-footer">
				<span></span>
				<div style="display: flex; gap: 10px;">
					<button type="button" onclick="document.getElementById('secret-modal').close()" class="btn btn-ghost">Cancel</button>
					<button type="submit" class="btn btn-primary">Save Changes</button>
				</div>
			</div>
		</form>
	</div>
}

templ SecretSaved(action string) {
	<div class="modal">
		<div class="modal-header">
			<div>
				<div class="modal-eyebrow">Administration</div>
				<div class="modal-title">Secret { action }</div>
			</div>
		</div>
		<div class="modal-body">
			<p style="color: var(--text-dim); font-size: 14px;">
				Your secret has been { action } successfully.
			</p>
		</div>
		<div class="modal-footer">
			<span></span>
			<button
				type="button"
				hx-get="/admin/secrets/table"
				hx-target="#secret-list"
				hx-swap="innerHTML"
				hx-on::after-request="document.getElementById('secret-modal').close()"
				class="btn btn-primary"
			>
				Done
			</button>
		</div>
	</div>
}
