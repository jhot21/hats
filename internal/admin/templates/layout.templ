package templates

templ Layout(title string, section string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — HATS Admin</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/admin/static/admin.css"/>
			<script src="/admin/static/htmx.min.js"></script>
			<script src="/admin/static/codemirror.min.js"></script>
			<script>
			function switchSecretType(type) {
			  document.querySelectorAll('.value-editor').forEach(function(el) {
			    el.style.display = el.dataset.type === type ? '' : 'none';
			  });
			}

			function togglePwd(btn) {
			  var input = btn.previousElementSibling;
			  if (input.type === 'password') { input.type = 'text'; btn.textContent = 'Hide'; }
			  else { input.type = 'password'; btn.textContent = 'Show'; }
			}

			function initCodeMirror(host, lang) {
			  if (!window.CM) return;
			  var hidden = host.parentElement.querySelector('[data-value-input]');
			  var extensions = [
			    CM.basicSetup,
			    CM.EditorView.updateListener.of(function(update) {
			      if (update.docChanged && hidden) hidden.value = update.state.doc.toString();
			    }),
			    CM.EditorView.theme({
			      '&': { background: 'var(--navy-950)', color: 'var(--text)', height: '200px' },
			      '.cm-scroller': { fontFamily: 'var(--font-mono)', fontSize: '13px', overflow: 'auto' },
			      '.cm-gutters': { background: 'var(--navy-900)', borderRight: '1px solid var(--border-strong)', color: 'var(--text-mute)' },
			      '.cm-activeLine': { background: 'var(--navy-850)' },
			      '&.cm-focused .cm-cursor': { borderLeftColor: 'var(--teal)' },
			      '.cm-selectionBackground, &.cm-focused .cm-selectionBackground': { background: 'var(--teal-dim) !important' },
			    }),
			  ];
			  if (lang === 'yaml' && CM.yaml) extensions.push(CM.yaml());
			  if (lang === 'json' && CM.json) extensions.push(CM.json());
			  var initialDoc = hidden ? hidden.value : '';
			  new CM.EditorView({ doc: initialDoc, extensions: extensions, parent: host });
			}

document.addEventListener('htmx:afterSwap', function(e) {
  if (e.target && e.target.id === 'modal-content') {
    var modal = e.target.querySelector('.modal');
    if (modal && modal.dataset.selectedType) {
      switchSecretType(modal.dataset.selectedType);
    }
    document.querySelectorAll('.cm-host').forEach(function(host) {
      initCodeMirror(host, host.dataset.lang);
    });
  }
});
			</script>
		</head>
		<body>
			<div class="app">
				<aside class="sidebar">
					<div class="brand">
						<div class="brand-mark">
							<svg viewBox="0 0 100 100" fill="none">
								<path d="M50 8 L86 29 L86 71 L50 92 L14 71 L14 29 Z" stroke="var(--teal)" stroke-width="3"/>
								<rect x="42" y="32" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
								<rect x="26" y="54" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
								<rect x="58" y="54" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
								<path d="M50 48 L50 54 M50 54 L34 54 M50 54 L66 54" stroke="var(--teal)" stroke-width="2.2"/>
							</svg>
						</div>
						<div class="brand-text">
							<span class="wordmark">HATS</span>
							<span class="subtitle">Control Plane</span>
						</div>
					</div>

					<div class="nav-section">
						<div class="nav-label">Observability</div>
						<a href="/admin" class={ NavLinkClass(title, "Dashboard") }>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
							Dashboard
						</a>
					</div>

					<div class="nav-section">
						<div class="nav-label">Administration</div>
						<a href="/admin/tokens" class={ NavLinkClass(title, "Tokens") }>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
							Tokens
						</a>
						<a href="/admin/secrets" class={ NavLinkClass(title, "Secrets") }>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
							Secrets
						</a>
						<a href="/admin/homeassistant" class={ NavLinkClass(title, "Home Assistant") }>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
							Home Assistant
						</a>
						<span class="nav-item disabled">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5"/><path d="M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></svg>
							Cache
						</span>
					</div>

					<div class="sidebar-footer">
						<a href="/admin/logout">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
							Logout
						</a>
					</div>
				</aside>

				<main class="main">
					<div class="topbar">
						<div class="topbar-brand">
							<div class="brand-mark">
								<svg viewBox="0 0 100 100" fill="none">
									<path d="M50 8 L86 29 L86 71 L50 92 L14 71 L14 29 Z" stroke="var(--teal)" stroke-width="3"/>
									<rect x="42" y="32" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
									<rect x="26" y="54" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
									<rect x="58" y="54" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
									<path d="M50 48 L50 54 M50 54 L34 54 M50 54 L66 54" stroke="var(--teal)" stroke-width="2.2"/>
								</svg>
							</div>
							<span class="wordmark">HATS</span>
						</div>
						<details class="nav-dropdown">
							<summary>
								{ title }
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
							</summary>
							<div class="nav-dropdown-menu">
								<a href="/admin">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
									Dashboard
								</a>
								<a href="/admin/tokens">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
									Tokens
								</a>
								<a href="/admin/secrets">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
									Secrets
								</a>
								<a href="/admin/homeassistant">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
									Home Assistant
								</a>
							</div>
						</details>
					</div>
					<div class="breadcrumb">
						<span>Home</span>
						<span class="sep">/</span>
						<span>{ section }</span>
						<span class="sep">/</span>
						<span class="current">{ title }</span>
					</div>
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
