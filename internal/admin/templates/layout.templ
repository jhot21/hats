package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — HATS Admin</title>
			<link rel="stylesheet" href="/admin/static/admin.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body class="h-full flex bg-slate-900 text-slate-100">
			<aside class="w-56 flex-shrink-0 bg-slate-800 flex flex-col">
				<div class="px-4 py-5 border-b border-slate-700">
					<span class="text-sm font-mono font-semibold text-slate-300 uppercase tracking-wider">HATS Admin</span>
				</div>
				<nav class="flex-1 px-3 py-4 space-y-1">
					<a href="/admin" class="flex items-center px-3 py-2 text-sm rounded-md text-slate-100 bg-slate-700 font-medium">
						Dashboard
					</a>
					<span class="flex items-center px-3 py-2 text-sm rounded-md text-slate-500 cursor-not-allowed">
						Tokens
					</span>
					<span class="flex items-center px-3 py-2 text-sm rounded-md text-slate-500 cursor-not-allowed">
						Secrets
					</span>
					<span class="flex items-center px-3 py-2 text-sm rounded-md text-slate-500 cursor-not-allowed">
						Cache
					</span>
				</nav>
				<div class="px-3 py-4 border-t border-slate-700">
					<a href="/admin/logout" class="flex items-center px-3 py-2 text-sm rounded-md text-slate-400 hover:text-slate-100 hover:bg-slate-700 transition-colors">
						Logout
					</a>
				</div>
			</aside>
			<main class="flex-1 overflow-auto p-8">
				{ children... }
			</main>
		</body>
	</html>
}
