package templates

templ Login(errMsg string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Login — HATS Admin</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/admin/static/admin.css"/>
		</head>
		<body class="login-page">
				<div class="login-card">
					<div class="panel" style="padding: 36px 40px;">
						<div class="login-title">
							<div class="brand-mark">
								<svg viewBox="0 0 100 100" fill="none">
									<path d="M50 8 L86 29 L86 71 L50 92 L14 71 L14 29 Z" stroke="var(--teal)" stroke-width="3"/>
									<rect x="42" y="32" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
									<rect x="26" y="54" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
									<rect x="58" y="54" width="16" height="16" stroke="var(--teal)" stroke-width="2.2" fill="none"/>
									<path d="M50 48 L50 54 M50 54 L34 54 M50 54 L66 54" stroke="var(--teal)" stroke-width="2.2"/>
								</svg>
							</div>
							<div>
								<span class="wordmark">HATS</span>
								<span class="subtitle">Admin Access</span>
							</div>
						</div>
						if errMsg != "" {
							<p class="login-error">{ errMsg }</p>
						}
						<form method="POST" action="/admin/login" style="display: flex; flex-direction: column; gap: 20px;">
							<div class="form-field">
								<label class="form-label" for="password">Password <span class="required">*</span></label>
								<input
									id="password"
									type="password"
									name="password"
									autofocus
									class="form-input"
								/>
							</div>
							<button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">
								Sign in
							</button>
						</form>
					</div>
			</div>
		</body>
	</html>
}
